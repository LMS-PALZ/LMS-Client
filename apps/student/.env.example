NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:5173
NEXT_PUBLIC_STAGING_URL=https://testcnflms.netlify.app
NEXT_PUBLIC_PRODUCTION_URL=https://student.skillscaleup.org
NEXT_PUBLIC_API_URL=https://base-api.skillscaleup.org

# Student home dashboard mock (until home API is wired)
# populated | empty
NEXT_PUBLIC_STUDENT_HOME_VARIANT=populated
# Student calendar mock: populated (default) | empty
# NEXT_PUBLIC_STUDENT_CALENDAR_VARIANT=empty
# Set true when replacing mock with live home endpoints
NEXT_PUBLIC_STUDENT_USE_HOME_API=false

# Local dev only (use .env.local, never enable in deployed envs)
# NEXT_PUBLIC_BYPASS_PROFILE_SETUP=true

# Live class video: jitsi (embed in page) | google-meet (opens new tab)
# NEXT_PUBLIC_LIVE_VIDEO_PROVIDER=jitsi
# NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si

# Google Classroom OAuth (server-side, apps/student API routes)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/api/google/callback
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/classroom.courses.readonly,https://www.googleapis.com/auth/classroom.coursework.me.readonly
TOKEN_ENCRYPTION_SECRET=
