NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:5175
NEXT_PUBLIC_STAGING_URL=
NEXT_PUBLIC_PRODUCTION_URL=https://admin.skillscaleup.org
NEXT_PUBLIC_API_URL=https://base-api.skillscaleup.org

# Live session embed uses Zoom Meeting SDK (server-side credentials in .env.local)
# Create a Meeting SDK app at https://marketplace.zoom.us/
# Same values used by the student app — required for in-app join on admin/tutor.
# ZOOM_MEETING_SDK_CLIENT_ID=
# ZOOM_MEETING_SDK_CLIENT_SECRET=
# Legacy aliases also supported:
# ZOOM_SDK_KEY=
# ZOOM_SDK_SECRET=
