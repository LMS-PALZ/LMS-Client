{
  "name": "ssu-lms",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ssu/student",
    "dev:student": "npm run dev -w @ssu/student",
    "dev:tutor": "npm run dev -w @ssu/tutor",
    "dev:admin": "npm run dev -w @ssu/admin",
    "build": "npm run build -ws --if-present",
    "lint": "oxlint . --deny-warnings --react-plugin --jest-plugin",
    "typecheck": "tsc --noEmit -p packages/types/tsconfig.json && tsc --noEmit -p packages/utils/tsconfig.json && tsc --noEmit -p packages/schema/tsconfig.json && tsc --noEmit -p packages/api/tsconfig.json && tsc --noEmit -p packages/queries/tsconfig.json && tsc --noEmit -p packages/ui/tsconfig.json && tsc --noEmit -p apps/student/tsconfig.json && tsc --noEmit -p apps/tutor/tsconfig.json && tsc --noEmit -p apps/admin/tsconfig.json",
    "verify": "npm run lint && npm run typecheck && npm run test --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "storybook": "npm run storybook -w @ssu/ui",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "oxlint": "^1.61.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": [
      "prettier --write"
    ],
    "apps/student/**/*.{ts,tsx}": [
      "oxlint --fix --deny-warnings --react-plugin --jest-plugin"
    ],
    "apps/tutor/**/*.{ts,tsx}": [
      "oxlint --fix --deny-warnings --react-plugin --jest-plugin"
    ],
    "apps/admin/**/*.{ts,tsx}": [
      "oxlint --fix --deny-warnings --react-plugin --jest-plugin"
    ],
    "packages/**/*.{ts,tsx}": [
      "oxlint --fix --deny-warnings --react-plugin --vitest-plugin"
    ]
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.14.0"
  }
}
