# Monorepo root — shared secrets for both Next.js apps (admin + student).
# Both apps load this file via next.config (loadEnvConfig from repo root).
# For Netlify: add the same keys under Site configuration → Environment variables
# on BOTH the admin and student sites.

NEXT_PUBLIC_API_URL=https://base-api.skillscaleup.org

# Zoom Meeting SDK (in-app live class embed)
# Must be from a Meeting SDK app OR a General app with Features → Embed → Meeting SDK ON.
# Do NOT use Server-to-Server OAuth credentials here — Zoom returns error 3712.
# Create/configure at https://marketplace.zoom.us/
ZOOM_MEETING_SDK_CLIENT_ID=
ZOOM_MEETING_SDK_CLIENT_SECRET=
